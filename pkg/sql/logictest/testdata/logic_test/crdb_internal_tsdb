# LogicTest: local

# crdb_internal.tsdb is a generator builtin (not a virtual table). It
# takes a metric name and returns the per-source datapoints recorded for
# that metric in the last hour. Downsampling is the SQL caller's job
# (tsround() + GROUP BY).

# Permission: a non-admin without VIEWCLUSTERMETADATA cannot call it.
user testuser

statement error user testuser does not have VIEWCLUSTERMETADATA system privilege
SELECT * FROM crdb_internal.tsdb('cr.node.sql.select.count')

user root

# Basic call returns rows for a known metric. Whether any datapoints have
# been written by this point in the test run depends on the cluster's
# warmup, so we assert only that the query succeeds and surfaces the
# expected column shape.
statement ok
SELECT timestamp, value, source FROM crdb_internal.tsdb('cr.node.sql.select.count')

# Downsampling via tsround() + GROUP BY composes with the function.
# Note that the bucket interval is passed as a bare string literal —
# CRDB infers INTERVAL from context, so 'INTERVAL' is unnecessary.
statement ok
SELECT source, tsround(timestamp, '1m') AS bucket, max(value)
  FROM crdb_internal.tsdb('cr.node.sql.select.count')
 GROUP BY 1, 2
 ORDER BY 1, 2

# An unknown metric returns zero rows rather than an error.
query I
SELECT count(*) FROM crdb_internal.tsdb('cr.node.does.not.exist')
----
0

# WHERE-clause time-bounding works as a post-filter. A bound entirely in
# the future returns zero rows.
query I
SELECT count(*) FROM crdb_internal.tsdb('cr.node.sql.select.count')
 WHERE timestamp > now() + INTERVAL '1 hour'
----
0

# Per-store metrics: the source column carries the raw TSDB identifier
# verbatim (store ID, or "<nodeID>-<storeID>" for some metric families).
statement ok
SELECT timestamp, value, source FROM crdb_internal.tsdb('cr.store.livebytes')

# Granting VIEWCLUSTERMETADATA unblocks the function for a non-admin.
statement ok
GRANT SYSTEM VIEWCLUSTERMETADATA TO testuser

user testuser

statement ok
SELECT timestamp, value, source FROM crdb_internal.tsdb('cr.node.sql.select.count')

user root

statement ok
REVOKE SYSTEM VIEWCLUSTERMETADATA FROM testuser

# tsround accepts a bare string literal in the bucket position thanks to
# implicit string→INTERVAL coercion. This is purely a sanity check on
# the existing tsround signature (no tsdb call needed).
query T
SELECT tsround('2026-04-29 12:34:56'::timestamptz, '1m')::string
----
2026-04-29 12:34:00+00
